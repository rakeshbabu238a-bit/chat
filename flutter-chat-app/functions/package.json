    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.2.0"
  },
  "private": true
}
